# Copy to the repo root on the VPS:
#   cp deploy/env.example .env
# Then replace every CHANGE_ME value. Do not commit .env.

# Public API (phones hit this). Switch to https://api.YOURDOMAIN.com after TLS.
API_URL=http://64.176.81.197:3011
API_HOST_PORT=3011

# Mongo (container-only; not published to the host)
MONGO_ROOT_USER=bmadmin
MONGO_ROOT_PASSWORD=CHANGE_ME_16_PLUS_CHARS
MONGO_DB=building_prod

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_LONG_RANDOM
JWT_EXPIRES_IN=7d

# Native apps send no Origin. * is fine for the mobile API.
CORS_ORIGINS=*

# First boot creates this app_admin if none exists. Change after login.
ADMIN_EMAIL=admin@yourbuilding.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Keep false in production. true seeds demo users (guard@bm.com, etc.).
SEED_DEMO=false

# Only needed with docker-compose.https.yml
# DOMAIN=api.yourdomain.com
