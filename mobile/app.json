{
  "expo": {
    "name": "Barighorr",
    "slug": "barighorr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "barighorr",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF",
      "translucent": true
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF"
    },
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E40AF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.barighorr.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan guest QR codes for visitor approval",
        "NSPhotoLibraryUsageDescription": "Upload photos for marketplace listings and complaints"
      }
    },
    "android": {
      "package": "com.barighorr.app",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "backgroundColor": "#FFFFFF",
      "adaptiveIcon": {
        "backgroundColor": "#1E40AF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      [
        "expo-notifications",
        {
          "color": "#4F46E5",
          "defaultChannel": "notices"
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "http://64.176.81.197:3011/api/v1",
      "router": {},
      "eas": {
        "projectId": "1cbe49f9-c6ee-459d-860a-401feba94d9d"
      }
    },
    "owner": "theshadowgardenassociation"
  }
}
