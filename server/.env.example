NODE_ENV=development
PORT=3001

# MongoDB Atlas (dev) — use building_dev database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/building_dev?appName=bm-app

# Production (Docker on the VPS) — do not commit the real .env
# See deploy/env.example and DEPLOY.md
# MONGODB_URI=mongodb://bmadmin:password@mongo:27017/building_prod?authSource=admin
# API_URL=http://64.176.81.197:3011


JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated origins for CORS (Expo dev uses your LAN IP)
CORS_ORIGINS=http://localhost:8081,exp://192.168.1.5:8081

# Public API URL (used in responses / uploads)
API_URL=http://localhost:3001

# Expo Push uses Expo's free API — no extra secret required.
# Remote push needs a real EAS projectId on the mobile app (dev build / iOS).
